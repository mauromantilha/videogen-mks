# Copie para .env e preencha. Nunca versione o .env.

# --- Aplicação
APP_ENV=dev
WORKSPACE_DIR=./workspace
MODELS_CONFIG=./config/models.yaml
LOG_LEVEL=INFO

# --- Login (local = sem login, só 127.0.0.1; neon = Neon Auth + membros)
AUTH_MODE=local
NEON_AUTH_URL=
APP_PUBLIC_URL=http://localhost:8000
DATABASE_URL=
AUTH_ALLOWED_DOMAIN=mksseguros.com
AUTH_BOOTSTRAP_ADMIN=

# --- Provedores (PROVIDER_MODE=fake roda tudo a custo zero)
PROVIDER_MODE=real
DEEPSEEK_API_KEY=
REPLICATE_API_TOKEN=
FAL_KEY=
DEEPINFRA_API_TOKEN=

# --- Paralelismo
MAX_PARALLEL_JOBS=2
MAX_PARALLEL_TTS=6
MAX_PARALLEL_VIDEO=4
MAX_PARALLEL_FFMPEG=2

# --- Resiliência e custo
HTTP_MAX_ATTEMPTS=3
VIDEO_TIMEOUT_S=300
DEFAULT_MAX_BUDGET_USD=2.00

# --- Mídia
LOUDNESS_LUFS=-14
SYNC_TOLERANCE_S=0.2
SYNC_STRETCH_MIN=0.85
SYNC_STRETCH_MAX=1.35
